# The format announces itself by its extension alone, so this is a specific-format bid.
# Lower it to around 0.3 if {{ suffix }} is a container other readers also claim;
# see docs/ADAPTERS.md on picking a confidence.
_CONFIDENCE = 0.9

_SUFFIX = "{{ suffix }}"


