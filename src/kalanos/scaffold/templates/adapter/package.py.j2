class {{ class_name }}(TabularAdapter):
    """Reads any `{{ suffix }}` file."""

    name = "{{ name }}"

    def detect(self, path: UPath) -> float:
        """Bid on the extension."""

        return _CONFIDENCE if path.suffix.lower() == _SUFFIX else 0.0

    def parse(self, path: UPath) -> ParsedTable:
        """Read one file into a frame of rows.

        Everything after this — the time axis, splitting rows into instances,
        sampling regularity, and resolving field names to taxonomy types —
        is `TabularAdapter`'s.
        """

        # TODO: replace with the {{ name }} format's own reader.
        # The placeholder reads the generated CSV fixture so the contract test is green
        # from the first run; swap the fixture at the same time.
        with path.open("rb") as handle:
            return ParsedTable(frame=pl.read_csv(source=handle))
