repository-artifact: "https://pypi.org/project/kalanos/"
keywords:
  - robotics
  - robot learning
  - imitation learning
  - data quality
  - dataset validation
  - LeRobot
  - HDF5
  - MCAP
  - ROS 2
  - sensor data
